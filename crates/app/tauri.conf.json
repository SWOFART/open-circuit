{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Circuit",
  "version": "0.1.0",
  "identifier": "org.swofart.opencircuit",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev:web",
      "cwd": "../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "pnpm build:web",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Circuit",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
