Open Circuit Stage 14: limit_switch-pressed
.options reltol=1e-9 abstol=1e-13 vntol=1e-10 temp=27 tnom=27
Vin input 0 24
Vsense input p 0
Rpart p 0 0.01
.op
.control
set noaskquit
set numdgt=16
set wr_singlescale
run
