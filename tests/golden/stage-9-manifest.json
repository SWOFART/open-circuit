{
  "manifestVersion": 1,
  "issue": "https://github.com/SWOFART/open-circuit/issues/165",
  "parent": "https://github.com/SWOFART/open-circuit/issues/154",
  "contract": "docs/contracts/stage-9-three-phase-foundation.md",
  "documentation": "docs/solver/stage-9-references.md",
  "sources": {
    "analytical": {
      "tool": "scripts/stage9-references.mjs",
      "method": "Closed-form first-order RC and RL startup responses, the underdamped RLC response, sinusoidal steady-state phasors, and a complex nodal solve for the three-phase linear loads. Uses Node's built-in Math only; no Engine, simulator, or package.",
      "file": "stage-9-analytical.expected.json"
    },
    "ngspice": {
      "simulator": "ngspice-47",
      "release": "https://sourceforge.net/projects/ngspice/files/ng-spice-rework/47/ngspice-47_64.7z",
      "archiveSha256": "59225971bd68cdd1199443649aa4615a9e6d684933f205ab49006a3942518f5a",
      "license": "Modified BSD (ngspice COPYING); ngspice is not stored in this repository and is not a build or normal-test dependency.",
      "options": "temp=27 tnom=27 gmin=0 method=trap reltol=1e-10 vntol=1e-12 abstol=1e-14 savecurrents",
      "transient": "tran 0.00005000000000000000 <stop> 0 0.000001000000000000000 uic; passive currents are recorded with savecurrents",
      "file": "stage-9-ngspice.expected.json"
    }
  },
  "signAndTimeConventions": {
    "source": "SIN(0, sqrt(2) * Vrms, frequencyHz, 0, 0, phaseOffsetDegrees); pin1 or the first winding terminal is positive.",
    "branchCurrent": "Positive from the first node named in each netlist element to the second.",
    "threePhase": "Positive sequence is 0, -120, +120 degrees; reversed sequence swaps the second and third phases.",
    "startup": "The RC, RL, and RLC cases set C/L initial states to the Stage 9 operating point at e(0) and retain the start-up transient.",
    "threePhaseObservations": "The three-phase cases are observed after 0.1 s, at 21 evenly spaced times over one 50 Hz period; RL startup has decayed before the window."
  },
  "tolerances": {
    "engine": {
      "steadyStateAmplitudeRelative50And60Hz": 0.005,
      "steadyStatePhaseDegrees50And60Hz": 0.3,
      "startupSignalAbsoluteFraction": 0.01,
      "measuredRmsMeanPeakPowerRelative": 0.002,
      "powerFactorAbsolute": 0.002,
      "measuredPhaseAngleDegrees": 0.3,
      "measuredFrequencyRelative": 0.001,
      "steadyStateAmplitudeRelative400Hz": 0.01,
      "balanceCurrentAbsoluteAmps": 1e-9,
      "balancePowerAbsoluteWatts": 1e-8
    },
    "ngspiceAgainstAnalytical": {
      "voltageAbsVolts": 0.0001,
      "currentAbsAmps": 0.000001,
      "powerAbsWatts": 0.0001,
      "powerFactorAbs": 0.000001,
      "phaseAngleAbsDegrees": 0.0001,
      "relative": 0.000001
    },
    "storedAnswerBalance": {
      "currentAbsAmps": 1e-9,
      "powerAbsWatts": 1e-8
    },
    "ngspiceBalance": {
      "currentAbsAmps": 1e-8,
      "powerAbsWatts": 0.001
    },
    "basis": "The contract estimates about 0.8% worst-case amplitude error at 400 Hz. Issue #165 fixes a 1e-2 relative tolerance, leaving a small margin; the 50/60 Hz tolerances remain the contract's values."
  },
  "regeneration": {
    "netlists": "node scripts/stage9-references.mjs --write-netlists",
    "analytical": "node scripts/stage9-references.mjs --analytical --write",
    "ngspice": "node scripts/stage9-references.mjs --ngspice <path to ngspice-47 console executable> --write",
    "offline": "node scripts/stage9-references.mjs --check",
    "rule": "Expected values are generated only from the closed-form references. The simulator validates those values and never replaces them; nothing is overwritten without --write."
  },
